# Binaries for programs and plugins
*.exe
*.exe~
*.dll
*.so
*.dylib

# Test binary, built with `go test -c`
*.test

# Output of the go coverage tool, specifically when used with LiteIDE
*.out

# Dependency directories (remove the comment below to include it)
# vendor/

# Go workspace file
go.work

# IDE specific files
.idea/
.vscode/
*.swp
*.swo

# Environment files
.env
.env.local
.env.*.local

# Build output
bin/
dist/

# Logs
*.log

# OS generated files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# Go build output
cmd/**/bin/
cmd/**/dist/

# 运行时上传的文件（保留默认头像，避免上传内容污染仓库）
public/uploads/*
!public/uploads/avatars/
!public/uploads/avatars/meteor-default.jpg

# 前端依赖与构建产物
node_modules/
web/dist

# TypeScript 增量构建信息，以及 vue-tsc -b 生成的 vite.config 临时产物
*.tsbuildinfo
web/vite.config.js
web/vite.config.d.ts
# Vite 加载配置时生成的带时间戳临时文件，异常中断时会留在源码目录
web/vite.config.js.timestamp-*.mjs
