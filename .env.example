# ===== docker-compose 配置（开发默认；复制为 .env 后可修改）=====
# 注意：改 MYSQL_ROOT_PASSWORD / MYSQL_DATABASE 时，务必同步修改 MYSQL_DSN 中的对应部分！
#
# compose 项目名默认取仓库目录名；项目已更名为 meteor-cms，但为兼容既有数据，
# docker-compose.yml 已把数据卷显式命名为 go-meteor-cms_mysql_data，
# 因此目录改名不会另建空库。若需要在新环境使用独立项目名，可显式设置：
# COMPOSE_PROJECT_NAME=meteor-cms
# 注意：新环境会创建新的空数据卷，需自行导入备份。

# --- MySQL ---
MYSQL_ROOT_PASSWORD=123456
# 库名保持 go_meteor_cms 以兼容既有数据库；改名等同于换空库，请先导出内容包。
MYSQL_DATABASE=go_meteor_cms
# 把 MySQL 暴露到宿主机的端口（默认不暴露，避免与本地 MySQL 的 3306 冲突）。
# 如需从宿主机用 GUI 直连，取消注释并改为 3306 或 3307，
# 同时取消 docker-compose.yml 里 mysql.ports 的注释。
# MYSQL_PORT=3306

# --- Redis（缓存 / 登录限流 / 全局踢人）---
# 宿主机映射端口；容器内服务间始终走 redis:6379，改此值不影响服务互通。
# 若本机 6379 已被其他 Redis 占用，改成如 6380 即可。
REDIS_PORT=6379

# --- API 对外端口 ---
API_PORT=8888

# --- 容器内服务间连接（固定使用 compose 服务名，一般无需改动）---
MYSQL_DSN=root:123456@tcp(mysql:3306)/go_meteor_cms?parseTime=True&loc=Local
REDIS_HOST=redis:6379
WEB_DIST=/app/web/dist

# --- JWT 密钥（生产必须设置，且两个值不同；更换 AccessSecret 会导致已有密文配置无法解密）---
# 留空则使用镜像内 etc/cms-api.yaml 的示例值，启动时会输出安全告警。
# AUTH_ACCESS_SECRET=<自定义随机字符串，至少 16 位>
# AUTH_REFRESH_SECRET=<另一个自定义随机字符串，至少 16 位>
# STRICT_SECURITY=true        # 设为 true 后示例密钥 / 关闭限流会直接拒绝启动
# SQL_DEBUG=false             # true 会把所有 SQL 及参数写入日志
# SCHEMA_CHECK_STRICT=true    # 启动时校验 schema_migrations 版本；紧急回滚可设 false

# --- 连接池 / 维护策略（留空使用配置文件默认值）---
# DB_MAX_OPEN_CONNS=20
# DB_MAX_IDLE_CONNS=10
# DB_CONN_MAX_LIFETIME=3600
# MAINTENANCE_AUDIT_RETENTION_DAYS=90

# --- 邮件（MAIL_ENABLED=true 时必须配置 HOST 与 FROM）---
# MAIL_ENABLED=false
# MAIL_HOST=smtp.example.com
# MAIL_PORT=587
# MAIL_USERNAME=noreply@example.com
# MAIL_PASSWORD=
# MAIL_FROM=Meteor CMS <noreply@example.com>

# --- 公开评论限流（feature_comment_enabled=true 时生效；Max<=0 表示不限流）---
# PUBLIC_COMMENT_RATE_MAX=5
# PUBLIC_COMMENT_RATE_WINDOW=60

# --- 安全开关（生产环境保持默认；仅本地开发 / 自动化 E2E 调整）---
# 登录验证码开关。默认 true；设为 false 后可直接用账号密码登录（无需先取验证码），
# 便于 curl / 脚本跑登录态 E2E。生产环境务必保持 true。
# LOGIN_CAPTCHA_ENABLED=false
# 免鉴权 /api/ 接口限流：每 IP 在 WINDOW 秒内最多 MAX 次，触发后拒绝 BLOCK 秒。
# PUBLIC_RATE_LIMIT_ENABLED=true
# PUBLIC_RATE_LIMIT_MAX=60
# PUBLIC_RATE_LIMIT_WINDOW=60
# PUBLIC_RATE_LIMIT_BLOCK=60

# --- 镜像版本（生产部署 / 回滚）---
# 默认使用本地构建的 meteor-cms:local；生产可固定到已发布版本。
# 回滚只需把版本号改回旧值，再执行 docker compose pull && docker compose up -d。
# CMS_IMAGE=ghcr.io/yuwen002/meteor-cms:1.2.3

# --- 容器构建镜像源（可选；默认走官方源，受限网络可改用镜像源）---
# NPM_REGISTRY=https://registry.npmmirror.com/
# GOPROXY=https://goproxy.cn,direct
