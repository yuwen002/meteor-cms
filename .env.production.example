# ===== 生产部署模板：复制为 .env 后逐项填写，再执行 make preflight =====
# 含真实密钥的 .env 已被 .gitignore 忽略，切勿提交。
# 标记 CHANGE_ME / REPLACE_WITH 的值未替换前，preflight 会直接判定 FAIL。

# --- 数据库（改口令时必须同步改 MYSQL_DSN，两者保持一致）---
# 库名保持 go_meteor_cms：改名等同于连到一个空库。
MYSQL_ROOT_PASSWORD=CHANGE_ME_strong_password
MYSQL_DATABASE=go_meteor_cms
MYSQL_DSN=root:CHANGE_ME_strong_password@tcp(mysql:3306)/go_meteor_cms?parseTime=True&loc=Local

# --- JWT 密钥（两个不同、各 >=16 位、非仓库示例值）---
# 生成方式：openssl rand -base64 48
# 注意：运行后更换 AccessSecret 会导致已加密的配置项无法解密。
AUTH_ACCESS_SECRET=CHANGE_ME_generate_with_openssl_rand_base64_48
AUTH_REFRESH_SECRET=CHANGE_ME_another_random_string
# true 时存在任何安全告警都会拒绝启动，生产必须开启。
STRICT_SECURITY=true

# --- 镜像版本（发版后填写；固定 X.Y.Z，勿用 latest，便于回滚）---
CMS_IMAGE=ghcr.io/yuwen002/meteor-cms:REPLACE_WITH_VERSION

# --- 迁移前备份（make backup 生成，24 小时内有效）---
CMS_BACKUP_FILE=backup/REPLACE_WITH_BACKUP_FILE.json

# --- 容器内服务间连接 ---
REDIS_HOST=redis:6379
WEB_DIST=/app/web/dist
API_PORT=8888
# REDIS_PORT=6380
# MYSQL_PORT=3306

# --- 安全开关（以下任一被关闭，STRICT_SECURITY=true 会拒绝启动）---
LOGIN_CAPTCHA_ENABLED=true
LOGIN_RATE_LIMIT_ENABLED=true
PUBLIC_RATE_LIMIT_ENABLED=true
PUBLIC_COMMENT_RATE_MAX=5
SQL_DEBUG=false
SCHEMA_CHECK_STRICT=true

# --- Prometheus 抓取端点（默认关闭，按需开启）---
# 开启后必须设置长度 >=16 位的 METRICS_TOKEN，否则 STRICT_SECURITY=true 会拒绝启动。
METRICS_ENABLED=false
# METRICS_TOKEN=CHANGE_ME_random_token_at_least_16_chars

# ===== GHCR 拉取凭证（二选一，部署机上执行）=====
# A. 把 Package 设为 Public：
#    GitHub -> 仓库 Packages -> meteor-cms -> Package settings -> Change visibility -> Public
# B. 保持 Private，创建仅含 read:packages 的 classic PAT 后登录：
#    read -rsp 'PAT: ' PAT && echo && printf '%s' "$PAT" | docker login ghcr.io -u <用户名> --password-stdin && unset PAT
#    用 read -s 避免 PAT 留在 shell history；完整步骤见 README「版本发布与回滚」。
#
# 部署命令（先 pull，不要加 --build，否则会本机重建并覆盖已发布镜像）：
#   docker compose pull && docker compose up -d
#
# 兼容性：数据卷必须继续使用 go-meteor-cms_mysql_data（compose 已显式声明卷名）。
# 旧 GHCR 包 ghcr.io/yuwen002/go-meteor-cms 下的 tag 不会自动迁移，
# 仍在使用旧 tag 的环境需保留过渡期，或在新仓库重发一份等价 tag。
