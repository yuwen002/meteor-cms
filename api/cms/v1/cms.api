type (
	// 禁用管理员请求
	DisableAdminReq {
		ID int64 `path:"id"`
	}
	// 启用管理员请求
	EnableAdminReq {
		ID int64 `path:"id"`
	}
	// 获取验证码响应
	CaptchaResp {
		Enabled       bool   `json:"enabled"` // 是否启用验证码
		CaptchaID     string `json:"captcha_id"` // 验证码ID
		CaptchaBase64 string `json:"captcha_base64"` // 验证码图片base64
	}
	// 登录请求
	LoginReq {
		Username  string `json:"username" validate:"required"` // 必填
		Password  string `json:"password" validate:"required"` // 必填
		CaptchaID string `json:"captcha_id,optional"` // 验证码ID（关闭开关时可不传）
		Captcha   string `json:"captcha,optional"` // 验证码
	}
	// 登录响应
	LoginResp {
		AccessToken  string `json:"access_token"`  // 访问令牌，短期有效
		RefreshToken string `json:"refresh_token"` // 刷新令牌，长期有效，用于换取新的访问令牌
	}
	// 忘记密码接口
	ForgotPasswordReq {
		Username string `json:"username" validate:"required"` // 必填
	}
	ForgotPasswordResp {
		Message string `json:"message"` // 返回提示
	}
	// 注册管理员接口
	RegisterReq {
		Username string `json:"username" validate:"required"` // 必填
		Password string `json:"password" validate:"required,min=6"` // 必填，最少 6 位
		Email    string `json:"email" validate:"required,email"` // 必填，格式必须是 email
		Nickname string `json:"nickname"` // 选填
	}
	RegisterResp {
		Message string `json:"message"` // 注册成功提示
	}
	// 通过邮件中的重置令牌设置新密码
	ResetPasswordByTokenReq {
		Token       string `json:"token" validate:"required"` // 重置令牌
		NewPassword string `json:"new_password" validate:"required,min=6"` // 新密码，至少 6 位
	}
	// 刷新访问令牌请求
	RefreshTokenReq {
		RefreshToken string `json:"refresh_token" validate:"required"` // 刷新令牌
	}
	// 刷新访问令牌响应
	RefreshTokenResp {
		AccessToken  string `json:"access_token"`  // 新的访问令牌
		RefreshToken string `json:"refresh_token"` // 新的刷新令牌（轮换后旧令牌立即失效）
	}
)

@server (
	middleware: ClientInfoMiddleware
)
service cms-api {
	// 获取验证码
	@handler GetCaptcha
	get /api/captcha returns (CaptchaResp)

	// 登录接口
	@handler Login
	post /admin/login (LoginReq) returns (LoginResp)

	@handler forgotPassword
	post /admin/forgot-password (ForgotPasswordReq) returns (ForgotPasswordResp)

	@handler registerAdmin
	post /admin/register (RegisterReq) returns (RegisterResp)

	// 通过邮件中的重置令牌设置新密码（忘记密码流程的第二步）
	@handler resetPasswordByToken
	post /admin/reset-password (ResetPasswordByTokenReq) returns (RegisterResp)

	// 使用刷新令牌换取新的访问令牌（无需 access token）
	@handler refreshToken
	post /admin/refresh (RefreshTokenReq) returns (RefreshTokenResp)
}

type (
	TestTokenResp {
		Message string                 `json:"message"`
		Claims  map[string]interface{} `json:"claims"`
	}
	AdminItem {
		Id          int64  `json:"id"`
		Username    string `json:"username"`
		Nickname    string `json:"nickname"`
		Email       string `json:"email"`
		Phone       string `json:"phone"`
		Avatar      string `json:"avatar"`
		IsSuper     bool   `json:"isSuper"`
		IsActive    bool   `json:"isActive"`
		LastLoginAt string `json:"last_login_at"`
		CreatedAt   string `json:"createdAt"`
		DeptId      int64  `json:"dept_id,optional"` // 所属部门ID
		DeptName    string `json:"dept_name,optional"` // 所属部门名称
	}
	AdminListReq {
		Page     int    `form:"page"` // 页码
		PageSize int    `form:"page_size"` // 每页数量
		Keyword  string `form:"keyword,optional"` // 搜索关键词（用户名/昵称/邮箱）
		Active   int    `form:"active,optional"` // 可选：过滤启用状态
		DeptId   int64  `form:"dept_id,optional"` // 可选：按部门筛选（与数据可见范围求交）
	}
	AdminListResp {
		Total    int64       `json:"total"`
		Page     int         `json:"page"`
		PageSize int         `json:"page_size"`
		List     []AdminItem `json:"list"`
	}
	ChangeMyPasswordReq {
		OldPassword string `json:"old_password"`
		NewPassword string `json:"new_password"`
	}
	ResetAdminPasswordReq {
		ID          int64  `json:"id"`
		NewPassword string `json:"new_password"`
	}
	CreateAdminReq {
		Username string `json:"username"`
		Password string `json:"password"`
		Nickname string `json:"nickname"`
		Email    string `json:"email"`
		Phone    string `json:"phone"`
		IsActive bool   `json:"is_active"`
		IsSuper  bool   `json:"is_super"`
	}
	CommonResp {
		ID      int64  `json:"id"`
		Message string `json:"message"`
	}
	AdminDetailReq {
		ID int64 `path:"id"`
	}
	// 获取管理员详情返回
	AdminDetailResp {
		ID       int64  `json:"id"`
		Username string `json:"username"`
		Nickname string `json:"nickname"`
		Email    string `json:"email"`
		Phone    string `json:"phone"`
		IsActive bool   `json:"is_active"`
	}
	// 更新管理员资料请求
	UpdateAdminReq {
		ID       int64   `path:"id"`
		Nickname *string `json:"nickname,optional"`
		Email    *string `json:"email,optional"`
		Phone    *string `json:"phone,optional"`
		IsActive *bool   `json:"is_active,optional"`
	}
	DeleteAdminReq {
		Id int64 `path:"id"`
	}
	DepartmentCreateReq {
		Name     string `json:"name"` // 部门名称
		ParentId int64  `json:"parent_id"` // 父级部门ID
		Sort     int    `json:"sort"` // 排序
		IsActive bool   `json:"is_active"` // 是否启用
		LeaderId int64  `json:"leader_id"` // 负责人ID
	}
	DepartmentUpdateReq {
		Id       int64  `path:"id"`
		Name     string `json:"name"`
		ParentId int64  `json:"parent_id"`
		Sort     int    `json:"sort"`
		IsActive bool   `json:"is_active"`
		LeaderId int64  `json:"leader_id"`
	}
	DepartmentDeleteReq {
		Id int64 `path:"id"`
	}
	DepartmentDetailReq {
		Id int64 `path:"id"`
	}
	DepartmentDetailResp {
		Id       int64  `json:"id"`
		Name     string `json:"name"`
		ParentId int64  `json:"parent_id"`
		Sort     int    `json:"sort"`
		IsActive bool   `json:"is_active"`
		LeaderId int64  `json:"leader_id"`
	}
	DepartmentTreeResp {
		Id       int64                `json:"id"`
		Name     string               `json:"name"`
		Sort     int                  `json:"sort"`
		IsActive bool                 `json:"is_active"`
		Children []DepartmentTreeResp `json:"children"`
	}
	AdminBindDeptReq {
		Id     int64 `path:"id"` // 管理员ID
		DeptId int64 `json:"dept_id"` // 部门ID
	}
	// 角色项
	RoleItem {
		ID        int64  `json:"id"`
		Name      string `json:"name"`
		Code      string `json:"code"`
		Desc      string `json:"desc"`
		DataScope int    `json:"data_scope"`
		IsSystem  bool   `json:"is_system"`
		IsActive  bool   `json:"is_active"`
		Sort      int    `json:"sort"`
		CreatedAt string `json:"created_at"`
		UpdatedAt string `json:"updated_at"`
	}
	// 角色列表请求
	RoleListReq {
		Page     int    `form:"page,default=1"` // 页码
		PageSize int    `form:"page_size,default=20"` // 每页数量
		Keyword  string `form:"keyword,optional"` // 搜索关键词（角色名称/编码）
		IsActive *bool  `form:"is_active,optional"` // 是否启用
	}
	// 角色列表响应
	RoleListResp {
		Total    int64      `json:"total"`
		Page     int        `json:"page"`
		PageSize int        `json:"page_size"`
		List     []RoleItem `json:"list"`
	}
	// 创建角色请求
	RoleCreateReq {
		Name      string `json:"name" validate:"required"` // 角色名称
		Code      string `json:"code" validate:"required"` // 角色编码
		Desc      string `json:"desc"` // 角色描述
		DataScope int    `json:"data_scope" default:"1"` // 数据权限范围
		IsActive  bool   `json:"is_active" default:"true"` // 是否启用
		Sort      int    `json:"sort" default:"0"` // 排序
	}
	// 更新角色请求
	RoleUpdateReq {
		ID        int64   `path:"id"`
		Name      *string `json:"name,optional,options=nonzero"` // 角色名称，如果提供则不能为空
		Code      *string `json:"code,optional,options=nonzero"` // 角色编码，如果提供则不能为空
		Desc      *string `json:"desc,optional"` // 角色描述
		DataScope *int    `json:"data_scope,optional"` // 数据权限范围
		IsActive  *bool   `json:"is_active,optional"` // 是否启用
		Sort      *int    `json:"sort,optional"` // 排序
	}
	// 角色详情请求
	RoleDetailReq {
		ID int64 `path:"id"`
	}
	// 删除请求
	RoleDeleteReq {
		ID int64 `path:"id"`
	}
	// 角色详情响应
	RoleDetailResp {
		RoleItem
	}
	// 分配角色权限请求
	RolePermissionAssignReq {
		RoleID        int64   `path:"id"`
		PermissionIDs []int64 `json:"permission_ids"` // 权限ID列表
	}
	// 获取角色权限ID列表响应
	RolePermissionIDsResp {
		PermissionIDs []int64 `json:"permission_ids"`
	}
	// 权限项
	PermissionItem {
		ID   int64  `json:"id"`
		Name string `json:"name"`
	}
	// 获取角色权限列表响应（包含权限名称）
	RolePermissionListResp {
		Permissions []PermissionItem `json:"permissions"`
	}
	// 权限管理模块
	// 权限项详情
	PermissionDetailItem {
		ID         int64  `json:"id"`
		Name       string `json:"name"`
		ParentID   int64  `json:"parent_id"`
		Type       int    `json:"type"`
		Path       string `json:"path"`
		Component  string `json:"component"`
		Icon       string `json:"icon"`
		Method     string `json:"method"`
		ApiPath    string `json:"api_path"`
		Permission string `json:"permission"`
		IsActive   bool   `json:"is_active"`
		Sort       int    `json:"sort"`
		CreatedAt  string `json:"created_at"`
		UpdatedAt  string `json:"updated_at"`
	}
	// 权限树结构
	PermissionTreeItem {
		ID         int64                `json:"id"`
		Name       string               `json:"name"`
		ParentID   int64                `json:"parent_id"`
		Type       int                  `json:"type"`
		Path       string               `json:"path"`
		Component  string               `json:"component"`
		Icon       string               `json:"icon"`
		Method     string               `json:"method"`
		ApiPath    string               `json:"api_path"`
		Permission string               `json:"permission"`
		IsActive   bool                 `json:"is_active"`
		Sort       int                  `json:"sort"`
		Children   []PermissionTreeItem `json:"children"`
	}
	// 权限列表请求
	PermissionListReq {
		Page     int    `form:"page,default=1"` // 页码
		PageSize int    `form:"page_size,default=20"` // 每页数量
		Keyword  string `form:"keyword,optional"` // 搜索关键词（权限名称/权限标识）
		Type     int    `form:"type,optional"` // 权限类型：1 菜单 2 按钮 3 API
		IsActive *bool  `form:"is_active,optional"` // 是否启用
	}
	// 权限列表响应
	PermissionListResp {
		Total    int64                  `json:"total"`
		Page     int                    `json:"page"`
		PageSize int                    `json:"page_size"`
		List     []PermissionDetailItem `json:"list"`
	}
	// 创建权限请求
	PermissionCreateReq {
		Name       string `json:"name" validate:"required"` // 权限名称
		ParentID   int64  `json:"parent_id"` // 父级ID
		Type       int    `json:"type" validate:"required"` // 权限类型：1 菜单 2 按钮 3 API
		Path       string `json:"path"` // 前端路由路径
		Component  string `json:"component"` // 前端组件路径
		Icon       string `json:"icon"` // 菜单图标
		Method     string `json:"method"` // API 方法
		ApiPath    string `json:"api_path"` // API 路径
		Permission string `json:"permission"` // 权限标识
		IsActive   bool   `json:"is_active" default:"true"` // 是否启用
		Sort       int    `json:"sort" default:"0"` // 排序
	}
	// 更新权限请求
	PermissionUpdateReq {
		ID         int64   `path:"id"`
		Name       *string `json:"name,optional"` // 权限名称
		ParentID   *int64  `json:"parent_id,optional"` // 父级ID
		Type       *int    `json:"type,optional"` // 权限类型
		Path       *string `json:"path,optional"` // 前端路由路径
		Component  *string `json:"component,optional"` // 前端组件路径
		Icon       *string `json:"icon,optional"` // 菜单图标
		Method     *string `json:"method,optional"` // API 方法
		ApiPath    *string `json:"api_path,optional"` // API 路径
		Permission *string `json:"permission,optional"` // 权限标识
		IsActive   *bool   `json:"is_active,optional"` // 是否启用
		Sort       *int    `json:"sort,optional"` // 排序
	}
	// 权限详情请求
	PermissionDetailReq {
		ID int64 `path:"id"`
	}
	// 删除权限请求
	PermissionDeleteReq {
		ID int64 `path:"id"`
	}
	// 权限详情响应
	PermissionDetailResp {
		PermissionDetailItem
	}
	// 角色自定义数据范围的部门
	RoleDeptReq {
		ID      int64   `path:"id"` // 角色ID
		DeptIDs []int64 `json:"dept_ids"` // 部门ID列表，data_scope=5 时生效
	}
	// 角色绑定的部门列表响应
	RoleDeptResp {
		DeptIDs []int64 `json:"dept_ids"`
	}
	// 管理员角色项
	AdminRoleItem {
		ID        int64  `json:"id"`
		Name      string `json:"name"`
		Code      string `json:"code"`
		Desc      string `json:"desc"`
		DataScope int    `json:"data_scope"`
		IsSystem  bool   `json:"is_system"`
		IsActive  bool   `json:"is_active"`
		Sort      int    `json:"sort"`
		CreatedAt string `json:"created_at"`
	}
	// 管理员角色列表响应
	AdminRoleListResp {
		Roles []AdminRoleItem `json:"roles"`
	}
	// 分配管理员角色请求
	AdminRoleAssignReq {
		ID      int64   `path:"id"` // 管理员ID
		RoleIDs []int64 `json:"role_ids"` // 角色ID列表
	}
	// 移除管理员角色请求
	AdminRoleRemoveReq {
		ID     int64 `path:"id"` // 管理员ID
		RoleID int64 `path:"role_id"` // 角色ID
	}
	// 当前登录用户的菜单项（Type=1 菜单）
	MyMenuItem {
		ID         int64        `json:"id"`
		Name       string       `json:"name"`
		ParentID   int64        `json:"parent_id"`
		Path       string       `json:"path"`
		Component  string       `json:"component"`
		Icon       string       `json:"icon"`
		Permission string       `json:"permission"`
		Sort       int          `json:"sort"`
		Children   []MyMenuItem `json:"children"`
	}
	// 当前登录用户的菜单与权限
	MyPermissionResp {
		IsSuper     bool         `json:"is_super"`
		Menus       []MyMenuItem `json:"menus"`
		Permissions []string     `json:"permissions"`
	}
	// 当前登录管理员的个人信息
	AdminProfileResp {
		ID          int64  `json:"id"`
		Username    string `json:"username"`
		Nickname    string `json:"nickname"`
		Email       string `json:"email"`
		Phone       string `json:"phone"`
		Avatar      string `json:"avatar"`
		IsSuper     bool   `json:"is_super"`
		DeptID      int64  `json:"dept_id"`
		LastLoginAt string `json:"last_login_at"`
		CreatedAt   string `json:"created_at"`
	}
	// 更新个人资料请求，未传字段保持不变
	UpdateProfileReq {
		Nickname *string `json:"nickname,optional"`
		Email    *string `json:"email,optional"`
		Phone    *string `json:"phone,optional"`
		Avatar   *string `json:"avatar,optional"`
	}
	// 操作日志列表请求
	OperationLogListReq {
		Page      int    `form:"page,default=1"`
		PageSize  int    `form:"page_size,default=20"`
		UserID    int64  `form:"user_id,optional"`
		Username  string `form:"username,optional"`
		Module    string `form:"module,optional"`
		Path      string `form:"path,optional"`
		Status    *int   `form:"status,optional"`
		StartTime string `form:"start_time,optional"`
		EndTime   string `form:"end_time,optional"`
	}
	// 操作日志项
	OperationLogItem {
		ID         int64  `json:"id"`
		UserID     int64  `json:"user_id"`
		Username   string `json:"username"`
		Module     string `json:"module"`
		Action     string `json:"action"`
		Method     string `json:"method"`
		Path       string `json:"path"`
		IP         string `json:"ip"`
		UserAgent  string `json:"user_agent"`
		Status     int    `json:"status"`
		ErrorMsg   string `json:"error_msg"`
		DurationMs int64  `json:"duration_ms"`
		Params     string `json:"params"`
		Query      string `json:"query"`
		RequestID  string `json:"request_id"`
		BizCode    int    `json:"biz_code"`
		HTTPStatus int    `json:"http_status"`
		CreatedAt  string `json:"created_at"`
	}
	// 操作日志列表响应
	OperationLogListResp {
		Total    int64              `json:"total"`
		Page     int                `json:"page"`
		PageSize int                `json:"page_size"`
		List     []OperationLogItem `json:"list"`
	}
	// 登录日志列表请求
	LoginLogListReq {
		Page      int    `form:"page,default=1"`
		PageSize  int    `form:"page_size,default=20"`
		UserID    int64  `form:"user_id,optional"`
		Username  string `form:"username,optional"`
		Status    *int   `form:"status,optional"`
		StartTime string `form:"start_time,optional"`
		EndTime   string `form:"end_time,optional"`
	}
	// 登录日志项
	LoginLogItem {
		ID         int64  `json:"id"`
		UserID     int64  `json:"user_id"`
		Username   string `json:"username"`
		IP         string `json:"ip"`
		UserAgent  string `json:"user_agent"`
		Status     int    `json:"status"`
		FailReason string `json:"fail_reason"`
		RequestID  string `json:"request_id"`
		LoginAt    string `json:"login_at"`
	}
	// 登录日志列表响应
	LoginLogListResp {
		Total    int64          `json:"total"`
		Page     int            `json:"page"`
		PageSize int            `json:"page_size"`
		List     []LoginLogItem `json:"list"`
	}
	// 文件上传响应
	UploadFileResp {
		URL      string `json:"url"`
		Filename string `json:"filename"`
		Size     int64  `json:"size"`
	}
)

@server (
	middleware: ClientInfoMiddleware,JwtMiddleware,PermissionMiddleware,OperationLogMiddleware
)
service cms-api {
	@handler testToken
	get /admin/test-token returns (TestTokenResp)

	@handler adminLogout
	post /admin/logout returns (CommonResp)

	@handler adminList
	get /admin/admin-users (AdminListReq) returns (AdminListResp)

	// 管理员修改自己的密码
	@handler changeMyPassword
	put /admin/admin-users/me/change-password (ChangeMyPasswordReq) returns (CommonResp)

	// 管理员重置其他管理员的密码
	@handler resetAdminPassword
	put /admin/admin-users/reset-password (ResetAdminPasswordReq) returns (CommonResp)

	@handler adminCreate
	post /admin/admin-users/create (CreateAdminReq) returns (CommonResp)

	@handler adminDetail
	get /admin/admin-users/:id (AdminDetailReq) returns (AdminDetailResp)

	@handler adminUpdate
	put /admin/admin-users/:id (UpdateAdminReq) returns (CommonResp)

	@handler adminDelete
	delete /admin/admin-users/:id (DeleteAdminReq) returns (CommonResp)

	@handler disableAdmin
	put /admin/admin-users/:id/disable (DisableAdminReq) returns (CommonResp)

	@handler enableAdmin
	put /admin/admin-users/:id/enable (EnableAdminReq) returns (CommonResp)

	// 部门管理
	// 创建部门
	@handler departmentCreate
	post /admin/departments (DepartmentCreateReq) returns (CommonResp)

	// 更新部门信息
	@handler departmentUpdate
	put /admin/departments/:id (DepartmentUpdateReq) returns (CommonResp)

	// 删除部门
	@handler departmentDelete
	delete /admin/departments/:id (DepartmentDeleteReq) returns (CommonResp)

	// 获取部门详情
	@handler departmentDetail
	get /admin/departments/:id (DepartmentDetailReq) returns (DepartmentDetailResp)

	// 获取部门树结构
	@handler departmentTree
	get /admin/departments/tree returns ([]DepartmentTreeResp)

	// 管理员绑定部门
	@handler adminBindDepartment
	put /admin/admin-users/:id/bind-department (AdminBindDeptReq) returns (CommonResp)

	// 获取角色管理
	// 获取角色列表
	@handler roleList
	get /admin/roles (RoleListReq) returns (RoleListResp)

	// 获取角色详情
	@handler roleDetail
	get /admin/roles/:id (RoleDetailReq) returns (RoleDetailResp)

	// 创建角色
	@handler roleCreate
	post /admin/roles (RoleCreateReq) returns (CommonResp)

	// 更新角色
	@handler roleUpdate
	put /admin/roles/:id (RoleUpdateReq) returns (CommonResp)

	// 删除角色
	@handler roleDelete
	delete /admin/roles/:id (RoleDeleteReq) returns (CommonResp)

	// 获取角色权限ID列表
	@handler rolePermissionList
	get /admin/roles/:id/permissions (RoleDetailReq) returns (RolePermissionIDsResp)

	// 获取角色权限列表（包含权限名称）
	@handler rolePermissionListWithNames
	get /admin/roles/:id/permissions-with-names (RoleDetailReq) returns (RolePermissionListResp)

	// 分配角色权限
	@handler rolePermissionAssign
	put /admin/roles/:id/permissions (RolePermissionAssignReq) returns (CommonResp)

	// 权限管理模块
	// 获取权限列表
	@handler permissionList
	get /admin/permissions (PermissionListReq) returns (PermissionListResp)

	// 获取权限树结构
	@handler permissionTree
	get /admin/permissions/tree returns ([]PermissionTreeItem)

	// 获取权限详情
	@handler permissionDetail
	get /admin/permissions/:id (PermissionDetailReq) returns (PermissionDetailResp)

	// 创建权限
	@handler permissionCreate
	post /admin/permissions (PermissionCreateReq) returns (CommonResp)

	// 更新权限
	@handler permissionUpdate
	put /admin/permissions/:id (PermissionUpdateReq) returns (CommonResp)

	// 删除权限
	@handler permissionDelete
	delete /admin/permissions/:id (PermissionDeleteReq) returns (CommonResp)

	// 管理员角色管理
	// 获取管理员角色列表
	@handler adminRoleList
	get /admin/admin-users/:id/roles (AdminDetailReq) returns (AdminRoleListResp)

	// 分配管理员角色
	@handler adminRoleAssign
	put /admin/admin-users/:id/roles (AdminRoleAssignReq) returns (CommonResp)

	// 移除管理员角色
	@handler adminRoleRemove
	delete /admin/admin-users/:id/roles/:role_id (AdminRoleRemoveReq) returns (CommonResp)

	// 获取角色自定义数据范围的部门列表
	@handler roleDeptList
	get /admin/roles/:id/departments (RoleDetailReq) returns (RoleDeptResp)

	// 设置角色自定义数据范围的部门列表
	@handler roleDeptAssign
	put /admin/roles/:id/departments (RoleDeptReq) returns (CommonResp)

	// 获取当前登录用户的菜单树与功能权限标识（前端据此渲染菜单和按钮）
	@handler myPermissions
	get /admin/profile/permissions returns (MyPermissionResp)

	// 获取当前登录管理员的个人信息
	@handler myProfile
	get /admin/profile returns (AdminProfileResp)

	// 更新当前登录管理员的个人资料（不允许修改角色与启用状态）
	@handler updateMyProfile
	put /admin/profile (UpdateProfileReq) returns (AdminProfileResp)

	// 操作日志列表
	@handler operationLogList
	get /admin/logs/operations (OperationLogListReq) returns (OperationLogListResp)

	// 登录日志列表
	@handler loginLogList
	get /admin/logs/logins (LoginLogListReq) returns (LoginLogListResp)

	// 上传文件（头像等）
	@handler uploadFile
	post /admin/upload returns (UploadFileResp)

	// 仪表盘统计数据
	@handler dashboardStats
	get /admin/dashboard/stats returns (DashboardStatsResp)

	// 文件管理（列表 / 删除 / 重命名），需登录
	@handler fileList
	get /admin/files (FileListReq) returns (FileListResp)

	@handler fileDelete
	post /admin/files/delete (FileDeleteReq)

	@handler fileRename
	put /admin/files/rename (FileRenameReq)
}

// 仪表盘统计数据
type DashboardStatsResp {
	AdminCount      int64 `json:"admin_count"`
	DeptCount       int64 `json:"dept_count"`
	RoleCount       int64 `json:"role_count"`
	PermissionCount int64 `json:"permission_count"`
	TodayLoginCount int64 `json:"today_login_count"`
	TodayFailLogin  int64 `json:"today_fail_login"`
	WeekOpCount     int64 `json:"week_op_count"`
}

// 文件管理
type FileItem {
	Name         string `json:"name"`
	Path         string `json:"path"`     // 相对上传根目录的路径（使用 / 分隔）
	Url          string `json:"url"`      // 可访问的 URL
	Size         int64  `json:"size"`     // 字节；目录为 0
	Modified     int64  `json:"modified"` // 修改时间（Unix 秒）
	IsDir        bool   `json:"is_dir"`
	OriginalName string `json:"original_name"` // 上传时的原始文件名，历史文件为空
	Mime         string `json:"mime"`          // 真实 MIME，历史文件为空
	Width        int    `json:"width"`         // 图片宽，非图片为 0
	Height       int    `json:"height"`        // 图片高，非图片为 0
	RefCount     int    `json:"ref_count"`     // 被文章封面/正文引用的篇数
}

type FileListReq {
	Dir      string `json:"dir,optional"`      // 子目录，相对上传根；为空表示根目录
	Keyword  string `json:"keyword,optional"`  // 按文件名模糊匹配
	Page     int64  `json:"page,optional"`
	PageSize int64  `json:"page_size,optional"`
}

type FileListResp {
	List       []FileItem `json:"list"`
	Total      int64      `json:"total"`
	CurrentDir string     `json:"current_dir"`
}

type FileDeleteReq {
	Path string `json:"path"` // 相对上传根目录的路径
}

type FileRenameReq {
	Path    string `json:"path"`
	NewName string `json:"new_name"` // 新名称（不含路径分隔符）
}

