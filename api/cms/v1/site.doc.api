// 配置增强接口与前台只读站点/字典接口的 OpenAPI 文档源。
//
// 路由由 handler/sysroutes.go 独立注册；本文件只被 cmd/apidoc 读取。
// 新增手工路由时必须同步这里，cmd/apidoc/main_test.go 会用 Go 路由注册做覆盖校验。

type (
	ConfigKeyReq {
		Key string `path:"key"`
	}

	ConfigBatchItem {
		ID          int64   `json:"id"`
		ConfigValue *string `json:"config_value,optional"`
	}

	ConfigBatchUpdateReq {
		Items []ConfigBatchItem `json:"items"`
	}

	ConfigVersionItem {
		ID           int64  `json:"id"`
		ConfigID     int64  `json:"config_id"`
		ConfigKey    string `json:"config_key"`
		OldValue     string `json:"old_value"`
		NewValue     string `json:"new_value"`
		OperatorID   int64  `json:"operator_id"`
		OperatorName string `json:"operator_name"`
		CreatedAt    string `json:"created_at"`
	}

	ConfigVersionListResp {
		List []ConfigVersionItem `json:"list"`
	}

	ConfigRollbackReq {
		ID        int64 `path:"id"`
		VersionID int64 `json:"version_id"`
	}

	PublicDictReq {
		Code string `path:"code"`
	}

	PublicDictItem {
		Label     string `json:"label"`
		Value     string `json:"value"`
		IsDefault bool   `json:"is_default"`
		ParentID  int64  `json:"parent_id"`
		Sort      int    `json:"sort"`
	}

	PublicDictResp {
		Code  string           `json:"code"`
		Items []PublicDictItem `json:"items"`
	}

	SiteInfoResp {
		Name          string `json:"name"`
		Logo          string `json:"logo"`
		Description   string `json:"description"`
		Keywords      string `json:"keywords"`
		ICP           string `json:"icp"`
		Footer        string `json:"footer"`
		Language      string `json:"language"`
		TitleTemplate string `json:"title_template"`
		Theme         string `json:"theme"`
		PrimaryColor  string `json:"primary_color"`
		CommentEnabled bool  `json:"comment_enabled"`
	}
)

service cms-site-api {
	@handler configByKey
	get /admin/configs/key/:key (ConfigKeyReq) returns (ConfigItem)

	@handler configDetail
	get /admin/configs/:id (SystemIDReq) returns (ConfigItem)

	@handler configBatchUpdate
	post /admin/configs/batch (ConfigBatchUpdateReq) returns (CommonResp)

	@handler configVersions
	get /admin/config-versions/:id (SystemIDReq) returns (ConfigVersionListResp)

	@handler configRollback
	post /admin/config-versions/:id/rollback (ConfigRollbackReq) returns (CommonResp)

	@handler publicSite
	get /api/site returns (SiteInfoResp)

	@handler publicDict
	get /api/dicts/:code (PublicDictReq) returns (PublicDictResp)
}
